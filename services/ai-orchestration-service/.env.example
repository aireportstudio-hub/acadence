# Acadence Environment Variable Example | 2026-11-12
# Copy to .env locally (Cloudflare frontend: .dev.vars). Never commit real credentials.
# The names not explicitly named by the provider are ACADENCE-PROPOSED conventions.
# Core settings should be resolved for the phase using this module; conditional ones can stay blank.

# CORE | CONFIG | Environment: development, staging, production; defaults to development when unset
APP_ENV=development

# CORE | CONFIG | DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive); defaults to INFO when unset
# Explicitly empty or invalid APP_ENV and LOG_LEVEL values prevent startup.
# Never log credentials or raw sensitive student content.
LOG_LEVEL=INFO

# CORE | CONFIG | Set separately to the service name
SERVICE_NAME=ai-orchestration-service

# CORE | CONFIG | HTTP API version
API_VERSION=v1

# CORE | CONFIG | Origins explicitly permitted by the service, not wildcard with credentials
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WHEN-FEATURE-ENABLED | CONFIG | Sentry project DSN, server-only
SENTRY_DSN=

# WHEN-FEATURE-ENABLED | CONFIG | OpenTelemetry collector endpoint; authentication configured separately
OTEL_EXPORTER_OTLP_ENDPOINT=

# WHEN-FEATURE-ENABLED | CONFIG | Service identity for distributed traces
OTEL_SERVICE_NAME=ai-orchestration-service

# CORE | SECRET | Neon PostgreSQL DSN for service-owned ai schema and role; use TLS
DATABASE_URL=

# CORE | CONFIG | Connection pool size, subject to Cloud Run concurrency and Neon limits
DB_POOL_SIZE=5

# CORE | CONFIG | Limit concurrent PostgreSQL connections
DB_MAX_OVERFLOW=2

# CORE | CONFIG | Schema owned by this service; do not write to others
DB_SCHEMA=orchestration

# CORE | CONFIG | IAM-based service-to-service authentication, not an LLM/tool API key
S2S_AUTH_MODE=google_oidc

# CORE | CONFIG | Bound outbound service HTTP calls
S2S_REQUEST_TIMEOUT_SECONDS=15

# CORE | SECRET | Postgres checkpoint DSN for LangGraph; service-owned credential
CHECKPOINT_DATABASE_URL=

# CORE | SECRET | Claude API key
ANTHROPIC_API_KEY=

# WHEN-FEATURE-ENABLED | SECRET | Groq inference API key
GROQ_API_KEY=

# WHEN-FEATURE-ENABLED | SECRET | OpenAI model API key
OPENAI_API_KEY=

# CORE | CONFIG | Versioned tested model name; decide after evaluation
WRITER_MODEL_ID=

# CORE | CONFIG | Versioned tested planner model name
PLANNER_MODEL_ID=

# WHEN-FEATURE-ENABLED | CONFIG | Fast model for extraction/auxiliary tasks
FAST_MODEL_ID=

# CORE | CONFIG | Enable LangSmith traces after appropriate data redaction
LANGSMITH_TRACING=true

# CORE | SECRET | LangSmith tracing credential
LANGSMITH_API_KEY=

# CORE | CONFIG | Trace project for environment
LANGSMITH_PROJECT=acadence-dev

# CONDITIONAL | CONFIG | Needed for certain organization-scoped keys
LANGSMITH_WORKSPACE_ID=

# CORE | CONFIG | LangSmith endpoint; regional endpoint varies
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# CORE | CONFIG | Prompt version recorded with outputs
PROMPT_VERSION=v1

# CONDITIONAL | CONFIG | Voice backend provider, e.g. OpenAI Realtime or TTS/STT combination
VOICE_PROVIDER=UNSELECTED

# CONDITIONAL | CONFIG | Speech-to-text provider used after user permission
STT_PROVIDER=UNSELECTED

# CONDITIONAL | CONFIG | Tested transcription model ID
STT_MODEL_ID=

# CONDITIONAL | CONFIG | Text-to-speech provider
TTS_PROVIDER=UNSELECTED

# CONDITIONAL | CONFIG | Tested speech generation model ID
TTS_MODEL_ID=

# CONDITIONAL | CONFIG | Selected speaking voice ID
TTS_VOICE_ID=

# CONDITIONAL | CONFIG | Default speech language, allow user preference
VOICE_DEFAULT_LANGUAGE=en-IN

# CONDITIONAL | CONFIG | Short-lived voice session credential lifetime; mint backend-side
VOICE_SESSION_TTL_SECONDS=300

# CORE | CONFIG | Heartbeat interval for progress SSE stream
SSE_HEARTBEAT_SECONDS=20

# CONDITIONAL | CONFIG | Optional Cloud Tasks queue name/ID, only after dispatch provider enabled
CLOUD_TASKS_QUEUE_PATH=

# CONDITIONAL | CONFIG | Optional Pub/Sub fan-out topic; no Pub/Sub required for basic dispatch
PUBSUB_TOPIC_REPORT_EVENTS=

# CORE | CONFIG | Initial cap to avoid provider 429 and budget spikes
MAX_CONCURRENT_LLM_CALLS=2

# CORE | CONFIG | Bounded transient retries
LLM_MAX_RETRIES=3

# CORE | CONFIG | Per-request deadline
LLM_REQUEST_TIMEOUT_SECONDS=120

# CORE | CONFIG | Illustrative cost guard, not a provider spending limit
LLM_DAILY_BUDGET_USD=10

# CORE | CONFIG | Google Cloud project ID
GCP_PROJECT_ID=

# CORE | CONFIG | Region where Cloud Run jobs are deployed
GCP_REGION=

# CORE | CONFIG | Cloud Run Job resource name
REPORT_GENERATION_JOB_NAME=acadence-report-generation

# CORE | CONFIG | Dispatcher choice, Cloud Tasks optional
JOB_DISPATCH_MODE=cloud_run_jobs

# CORE | CONFIG | Auth verification service
AUTH_SERVICE_URL=http://localhost:8001

# CORE | CONFIG | Quota reservation/settlement service
BILLING_SERVICE_URL=http://localhost:8002

# CORE | CONFIG | Approved project facts and questions
PROJECT_SERVICE_URL=http://localhost:8003

# CORE | CONFIG | Approved template snapshot
TEMPLATE_SERVICE_URL=http://localhost:8004

# CORE | CONFIG | Quality checks
QUALITY_SERVICE_URL=http://localhost:8006

# CORE | CONFIG | Visual agents
VISUAL_AI_SERVICE_URL=http://localhost:8007

# CORE | CONFIG | Live preview and exports
DOCUMENT_SERVICE_URL=http://localhost:8008

# CONDITIONAL | CONFIG | Turn on when sourced citations are required
ENABLE_SOURCE_RETRIEVAL=false

# CONDITIONAL | CONFIG | Enable after provider selection and provenance controls
ENABLE_AI_IMAGES=false
