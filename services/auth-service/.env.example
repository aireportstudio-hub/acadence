# Acadence Environment Variable Example | 2026-11-12
# Copy to .env locally (Cloudflare frontend: .dev.vars). Never commit real credentials.
# The names not explicitly named by the provider are ACADENCE-PROPOSED conventions.
# Core settings should be resolved for the phase using this module; conditional ones can stay blank.

# CORE | CONFIG | Environment: development, staging, production; defaults to development when unset
APP_ENV=development

# CORE | CONFIG | DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive); defaults to INFO when unset
# Explicitly empty or invalid APP_ENV and LOG_LEVEL values prevent startup.
# Never log credentials or raw sensitive student content.
LOG_LEVEL=INFO

# CORE | CONFIG | Set separately to the service name
SERVICE_NAME=auth-service

# CORE | CONFIG | HTTP API version
API_VERSION=v1

# CORE | CONFIG | Origins explicitly permitted by the service, not wildcard with credentials
CORS_ALLOWED_ORIGINS=http://localhost:3001

# CORE | CONFIG | Exact frontend origin used for dashboard redirects and logout Origin checks
FRONTEND_APP_URL=http://localhost:3001

# WHEN-FEATURE-ENABLED | CONFIG | Sentry project DSN, server-only
SENTRY_DSN=

# WHEN-FEATURE-ENABLED | CONFIG | OpenTelemetry collector endpoint; authentication configured separately
OTEL_EXPORTER_OTLP_ENDPOINT=

# WHEN-FEATURE-ENABLED | CONFIG | Service identity for distributed traces
OTEL_SERVICE_NAME=auth-service

# CORE | SECRET | Neon PostgreSQL DSN for service-owned auth schema and role; use TLS
DATABASE_URL=

# CORE | CONFIG | Connection pool size, subject to Cloud Run concurrency and Neon limits
DB_POOL_SIZE=5

# CORE | CONFIG | Limit concurrent PostgreSQL connections
DB_MAX_OVERFLOW=2

# CORE | CONFIG | Schema owned by this service; do not write to others
DB_SCHEMA=auth

# CORE | CONFIG | IAM-based service-to-service authentication, not an LLM/tool API key
S2S_AUTH_MODE=google_oidc

# CORE | CONFIG | Bound outbound service HTTP calls
S2S_REQUEST_TIMEOUT_SECONDS=15

# WHEN-FEATURE-ENABLED | CONFIG | Upstash HTTPS REST endpoint
UPSTASH_REDIS_REST_URL=

# WHEN-FEATURE-ENABLED | SECRET | Upstash Redis REST token; never browser-visible
UPSTASH_REDIS_REST_TOKEN=

# CORE | CONFIG | Google OAuth application client ID; not equivalent to API secret
GOOGLE_OAUTH_CLIENT_ID=

# CONDITIONAL | SECRET | Server-side verification secret for Cloudflare Turnstile, if enabled
TURNSTILE_SECRET_KEY=

# CORE | CONFIG | Privacy-conscious risk checks; physical-device identity cannot be guaranteed
ENABLE_DEVICE_RISK_CHECKS=true

# CORE | SECRET | Google OAuth web-app client secret
GOOGLE_OAUTH_CLIENT_SECRET=

# CORE | CONFIG | Exact allowed redirect URI registered in Google console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/v1/auth/google/callback

# CORE | CONFIG | Validate issuer, audience, state, nonce and PKCE
OIDC_ISSUER=https://accounts.google.com

# CORE | CONFIG | JWT issuer
JWT_ISSUER=acadence-auth

# CORE | CONFIG | Intended API audience
JWT_AUDIENCE=acadence-api

# CORE | CONFIG | Chosen signing algorithm; no algorithm downgrade
JWT_ALGORITHM=RS256

# CORE | SECRET | Asymmetric private signing key from Secret Manager; PEM format
JWT_SIGNING_PRIVATE_KEY=

# CORE | CONFIG | Key rotation identifier (kid)
JWT_SIGNING_KEY_ID=acadence-dev-1

# CORE | CONFIG | Short-lived access token lifetime
ACCESS_TOKEN_TTL_SECONDS=900

# CORE | CONFIG | Session refresh lifetime, enforce rotation and revocation
REFRESH_TOKEN_TTL_DAYS=30

# CORE | CONFIG | Optional cookie domain; blank for localhost/host-only cookie
COOKIE_DOMAIN=

# CORE | CONFIG | True for HTTPS production
COOKIE_SECURE=false

# CONDITIONAL | CONFIG | Choose one SMS provider before enabling mobile auth
OTP_PROVIDER=UNSELECTED

# CORE | CONFIG | OTP expiry
OTP_TTL_SECONDS=300

# CORE | CONFIG | Verification attempt limit
OTP_MAX_ATTEMPTS=5

# CORE | CONFIG | Illustrative rate limit, tune via abuse tests
OTP_RATE_LIMIT_PER_HOUR=6

# CONDITIONAL | CONFIG | Only if Twilio chosen for OTP
TWILIO_ACCOUNT_SID=

# CONDITIONAL | SECRET | Only if Twilio chosen
TWILIO_AUTH_TOKEN=

# CONDITIONAL | CONFIG | Only if Twilio Verify chosen
TWILIO_VERIFY_SERVICE_SID=

# CONDITIONAL | SECRET | Generic slot for another approved OTP provider
SMS_PROVIDER_API_KEY=

# CORE | CONFIG | Used if SMS send/verify is delegated to notification service
NOTIFICATION_SERVICE_URL=http://localhost:8009
