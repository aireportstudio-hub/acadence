# Acadence Environment Variable Example | 2026-11-12
# Copy to .env locally (Cloudflare frontend: .dev.vars). Never commit real credentials.
# The names not explicitly named by the provider are ACADENCE-PROPOSED conventions.
# Core settings should be resolved for the phase using this module; conditional ones can stay blank.

# CORE | CONFIG | Environment: development, staging, production
APP_ENV=development

# CORE | CONFIG | Log verbosity; never log credentials or raw sensitive student content
LOG_LEVEL=INFO

# CORE | CONFIG | Set separately to the service name
SERVICE_NAME=quality-service

# CORE | CONFIG | HTTP API version
API_VERSION=v1

# CORE | CONFIG | Origins explicitly permitted by the service, not wildcard with credentials
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WHEN-FEATURE-ENABLED | CONFIG | Sentry project DSN, server-only
SENTRY_DSN=

# WHEN-FEATURE-ENABLED | CONFIG | OpenTelemetry collector endpoint; authentication configured separately
OTEL_EXPORTER_OTLP_ENDPOINT=

# WHEN-FEATURE-ENABLED | CONFIG | Service identity for distributed traces
OTEL_SERVICE_NAME=quality-service

# CORE | SECRET | Neon PostgreSQL DSN for service-owned quality schema and role; use TLS
DATABASE_URL=

# CORE | CONFIG | Connection pool size, subject to Cloud Run concurrency and Neon limits
DB_POOL_SIZE=5

# CORE | CONFIG | Limit concurrent PostgreSQL connections
DB_MAX_OVERFLOW=2

# CORE | CONFIG | Schema owned by this service; do not write to others
DB_SCHEMA=quality

# CORE | CONFIG | IAM-based service-to-service authentication, not an LLM/tool API key
S2S_AUTH_MODE=google_oidc

# CORE | CONFIG | Bound outbound service HTTP calls
S2S_REQUEST_TIMEOUT_SECONDS=15

# WHEN-FEATURE-ENABLED | SECRET | Use only if quality judge uses Anthropic
ANTHROPIC_API_KEY=

# WHEN-FEATURE-ENABLED | SECRET | Use only if quality judge uses OpenAI
OPENAI_API_KEY=

# WHEN-FEATURE-ENABLED | CONFIG | Evaluated LLM quality reviewer model ID
QUALITY_JUDGE_MODEL_ID=

# WHEN-FEATURE-ENABLED | SECRET | Voyage embeddings/reranking
VOYAGE_API_KEY=

# WHEN-FEATURE-ENABLED | CONFIG | Exact tested embedding model
EMBEDDING_MODEL_ID=

# CONDITIONAL | CONFIG | Only when retrieval reranking is used
RERANK_MODEL_ID=

# CORE | CONFIG | Upper bound for per-section targeted revisions
QUALITY_MAX_REVISIONS=3

# CONDITIONAL | CONFIG | Only if a licensed provider is selected
EXTERNAL_PLAGIARISM_PROVIDER=NONE

# CONDITIONAL | SECRET | Licensed provider credential only
EXTERNAL_PLAGIARISM_API_KEY=

# CONDITIONAL | CONFIG | Contact email for Crossref polite pool where relevant; not a secret
CROSSREF_MAILTO=

# CONDITIONAL | SECRET | Only if Semantic Scholar API with key used
SEMANTIC_SCHOLAR_API_KEY=

# CONDITIONAL | SECRET | Only if account/API plan requires it
OPENALEX_API_KEY=

# CORE | CONFIG | Canonical fact verification
PROJECT_SERVICE_URL=http://localhost:8003
