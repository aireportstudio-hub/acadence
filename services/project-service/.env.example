# Acadence Environment Variable Example | 2026-11-12
# Copy to .env locally (Cloudflare frontend: .dev.vars). Never commit real credentials.
# The names not explicitly named by the provider are ACADENCE-PROPOSED conventions.
# Core settings should be resolved for the phase using this module; conditional ones can stay blank.

# CORE | CONFIG | Environment: development, staging, production; defaults to development when unset
APP_ENV=development

# CORE | CONFIG | DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive); defaults to INFO when unset
# Explicitly empty or invalid APP_ENV and LOG_LEVEL values prevent startup.
# Never log credentials or raw sensitive student content.
LOG_LEVEL=INFO

# CORE | CONFIG | Set separately to the service name
SERVICE_NAME=project-service

# CORE | CONFIG | HTTP API version
API_VERSION=v1

# CORE | CONFIG | Origins explicitly permitted by the service, not wildcard with credentials
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WHEN-FEATURE-ENABLED | CONFIG | Sentry project DSN, server-only
SENTRY_DSN=

# WHEN-FEATURE-ENABLED | CONFIG | OpenTelemetry collector endpoint; authentication configured separately
OTEL_EXPORTER_OTLP_ENDPOINT=

# WHEN-FEATURE-ENABLED | CONFIG | Service identity for distributed traces
OTEL_SERVICE_NAME=project-service

# CORE | SECRET | Neon PostgreSQL DSN for service-owned project schema and role; use TLS
DATABASE_URL=

# CORE | CONFIG | Connection pool size, subject to Cloud Run concurrency and Neon limits
DB_POOL_SIZE=5

# CORE | CONFIG | Limit concurrent PostgreSQL connections
DB_MAX_OVERFLOW=2

# CORE | CONFIG | Schema owned by this service; do not write to others
DB_SCHEMA=project

# CORE | CONFIG | IAM-based service-to-service authentication, not an LLM/tool API key
S2S_AUTH_MODE=google_oidc

# CORE | CONFIG | Bound outbound service HTTP calls
S2S_REQUEST_TIMEOUT_SECONDS=15

# CORE | CONFIG | Cloudflare account ID for constructing S3 endpoint
R2_ACCOUNT_ID=

# CORE | CONFIG | https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=

# CORE | SECRET | R2 S3-compatible access key
R2_ACCESS_KEY_ID=

# CORE | SECRET | R2 S3-compatible secret access key
R2_SECRET_ACCESS_KEY=

# CORE | CONFIG | Private bucket; isolate production
R2_BUCKET_NAME=acadence-dev

# CORE | CONFIG | Short-lived private download/upload URL validity
R2_SIGNED_URL_TTL_SECONDS=300

# CORE | CONFIG | Identity/authorization integration
AUTH_SERVICE_URL=http://localhost:8001

# CORE | CONFIG | Entitlement and quota checks
BILLING_SERVICE_URL=http://localhost:8002

# CORE | CONFIG | Template snapshot reference
TEMPLATE_SERVICE_URL=http://localhost:8004

# CORE | CONFIG | Project workflow submission
AI_ORCHESTRATION_SERVICE_URL=http://localhost:8005

# CORE | CONFIG | Illustrative 15 MiB maximum per upload; tune for requirements
MAX_UPLOAD_BYTES=15728640

# CORE | CONFIG | Do not trust MIME only; inspect file signatures
ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# CORE | CONFIG | Student project screenshot/photo upload support
ENABLE_IMAGE_INPUTS=true

# CORE | CONFIG | Illustrative retention, finalize privacy policy
UPLOAD_RETENTION_DAYS=90
