{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project facts updated event v1",
  "description": "Project-to-AI-Orchestration notification. Fact values are read from Project at the pinned snapshot version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "project.facts.updated"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid",
      "description": "Opaque Project-owned project identifier."
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Fact snapshot version after this update."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_snapshot_version",
        "changed_fact_ids"
      ],
      "properties": {
        "fact_snapshot_version": {
          "type": "integer",
          "minimum": 1
        },
        "changed_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
