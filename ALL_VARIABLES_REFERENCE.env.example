# CONFIG | conditional | Tested multimodal model ID
VISION_MODEL_ID=

# CONFIG | conditional | Multimodal image-understanding provider
VISION_PROVIDER=

# CONFIG | core | Visual agents
VISUAL_AI_SERVICE_URL=

# CONFIG | conditional | Default speech language, allow user preference
VOICE_DEFAULT_LANGUAGE=

# CONFIG | conditional | Voice backend provider, e.g. OpenAI Realtime or TTS/STT combination
VOICE_PROVIDER=

# CONFIG | conditional | Short-lived voice session credential lifetime; mint backend-side
VOICE_SESSION_TTL_SECONDS=

# SECRET | when-feature-enabled | Voyage embeddings/reranking
