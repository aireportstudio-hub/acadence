# REFERENCE ONLY -- DO NOT SOURCE THIS FILE INTO ANY PROCESS
# Never give every service access to all credentials. Use the service-specific .env.example.
# This is an index for quickly seeing every key without opening each module.

# CONFIG | core | Short-lived access token lifetime
ACCESS_TOKEN_TTL_SECONDS=

# CONFIG | core | Project workflow submission
AI_ORCHESTRATION_SERVICE_URL=

# CONFIG | core | Do not trust MIME only; inspect file signatures
ALLOWED_IMAGE_MIME_TYPES=

# SECRET | core | Claude API key
ANTHROPIC_API_KEY=

# CONFIG | core | Private server-side URL for selected BFF/API ingress design
API_GATEWAY_ORIGIN=

# CONFIG | core | HTTP API version
API_VERSION=

# CONFIG | core | Environment: development, staging, production
APP_ENV=

# CONFIG | core | Auth service URL
AUTH_SERVICE_URL=

# SECRET | conditional | Only if direct Black Forest Labs API selected
BFL_API_KEY=

# CONFIG | core | Billing currency to validate with selected gateway
BILLING_CURRENCY=

# CONFIG | core | Entitlement and quota checks
BILLING_SERVICE_URL=

# SECRET | core | Postgres checkpoint DSN for LangGraph; service-owned credential
CHECKPOINT_DATABASE_URL=

# CONFIG | conditional | Cloudflare account ID for Workers AI REST API
CLOUDFLARE_ACCOUNT_ID=

# SECRET | conditional | For Cloud Run calling Cloudflare Workers AI REST API; not needed for Workers AI binding
CLOUDFLARE_AI_API_TOKEN=

# SECRET | core | CI deployment token for Workers/R2; least-privilege GitHub Actions secret
CLOUDFLARE_API_TOKEN=

# CONFIG | conditional | Optional Cloud Tasks queue name/ID, only after dispatch provider enabled
CLOUD_TASKS_QUEUE_PATH=

# CONFIG | core | Optional cookie domain; blank for localhost/host-only cookie
COOKIE_DOMAIN=

# CONFIG | core | True for HTTPS production
COOKIE_SECURE=

# CONFIG | core | Origins explicitly permitted by the service, not wildcard with credentials
CORS_ALLOWED_ORIGINS=

# CONFIG | conditional | Contact email for Crossref polite pool where relevant; not a secret
CROSSREF_MAILTO=

# SECRET | core | Neon PostgreSQL DSN for service-owned auth schema and role; use TLS
DATABASE_URL=

# CONFIG | core | Limit concurrent PostgreSQL connections
DB_MAX_OVERFLOW=

# CONFIG | core | Connection pool size, subject to Cloud Run concurrency and Neon limits
DB_POOL_SIZE=

# CONFIG | core | Schema owned by this service; do not write to others
DB_SCHEMA=

# CONFIG | core | Default template catalog revision
DEFAULT_TEMPLATE_CATALOG_VERSION=

# CONFIG | core | Cloud Run Job for heavy exports
DOCUMENT_EXPORT_JOB_NAME=

# CONFIG | core | Render/preview export integration
DOCUMENT_SERVICE_URL=

# CONFIG | core | Word generation library
DOCX_RENDERER=

# CONFIG | conditional | Security decision pending: Worker-to-GCP authentication/ingress; do not deploy public unprotected backend
EDGE_TO_API_AUTH_MODE=

# CONFIG | conditional | Verified sender address
EMAIL_FROM=

# CONFIG | conditional | Choose mail delivery service before email notifications
EMAIL_PROVIDER=

# CONFIG | when-feature-enabled | Exact tested embedding model
EMBEDDING_MODEL_ID=

# CONFIG | conditional | Enable after provider selection and provenance controls
ENABLE_AI_IMAGES=

# CONFIG | core | Privacy-conscious risk checks; physical-device identity cannot be guaranteed
ENABLE_DEVICE_RISK_CHECKS=

# CONFIG | conditional | Must label as AI-generated, never invent results
ENABLE_GENERATED_ILLUSTRATIONS=

# CONFIG | core | Student project screenshot/photo upload support
ENABLE_IMAGE_INPUTS=

# CONFIG | core | Backend must still enforce Premium entitlement
ENABLE_LATEX_EXPORT=

# CONFIG | conditional | Turn on OCR for scanned images/documents when needed
ENABLE_OCR_FALLBACK=

# CONFIG | conditional | Turn on when sourced citations are required
ENABLE_SOURCE_RETRIEVAL=

# CONFIG | conditional | Paid conversion only if purchased/validated
ENABLE_TIPTAP_CONVERSION=

# CONFIG | conditional | Paid pagination package only if purchased/validated
ENABLE_TIPTAP_PAGES=

# CONFIG | core | Injected per job execution; do not set in deployed static config
EXPORT_RUN_ID=

# SECRET | conditional | Licensed provider credential only
EXTERNAL_PLAGIARISM_API_KEY=

# CONFIG | conditional | Only if a licensed provider is selected
EXTERNAL_PLAGIARISM_PROVIDER=

# SECRET | conditional | Only if fal.ai selected
FAL_KEY=

# CONFIG | when-feature-enabled | Fast model for extraction/auxiliary tasks
FAST_MODEL_ID=

# CONFIG | core | CI deployment service account to impersonate via WIF
GCP_DEPLOY_SERVICE_ACCOUNT=

# CONFIG | core | Google Cloud project ID
GCP_PROJECT_ID=

# CONFIG | core | Region where Cloud Run jobs are deployed
GCP_REGION=

# CONFIG | core | Prefer WIF GitHub OIDC; avoid downloaded service-account key
GCP_WORKLOAD_IDENTITY_PROVIDER=

# CONFIG | core | Google OAuth application client ID; not equivalent to API secret
GOOGLE_OAUTH_CLIENT_ID=

# SECRET | core | Google OAuth web-app client secret
GOOGLE_OAUTH_CLIENT_SECRET=

# CONFIG | core | Exact allowed redirect URI registered in Google console
GOOGLE_OAUTH_REDIRECT_URI=

# SECRET | when-feature-enabled | Groq inference API key
GROQ_API_KEY=

# CONFIG | conditional | Choose a model provider: Cloudflare AI, BFL, fal.ai etc
IMAGE_GENERATION_PROVIDER=

# CONFIG | conditional | Actual image model ID after provider selection
IMAGE_MODEL_ID=

# CONFIG | core | Dispatcher choice, Cloud Tasks optional
JOB_DISPATCH_MODE=

# CONFIG | core | Chosen signing algorithm; no algorithm downgrade
JWT_ALGORITHM=

# CONFIG | core | Intended API audience
JWT_AUDIENCE=

# CONFIG | core | JWT issuer
JWT_ISSUER=

# CONFIG | core | Key rotation identifier (kid)
JWT_SIGNING_KEY_ID=

# SECRET | core | Asymmetric private signing key from Secret Manager; PEM format
JWT_SIGNING_PRIVATE_KEY=

# SECRET | core | LangSmith tracing credential
LANGSMITH_API_KEY=

# CONFIG | core | LangSmith endpoint; regional endpoint varies
LANGSMITH_ENDPOINT=

# CONFIG | core | Trace project for environment
LANGSMITH_PROJECT=

# CONFIG | core | Enable LangSmith traces after appropriate data redaction
LANGSMITH_TRACING=

# CONFIG | conditional | Needed for certain organization-scoped keys
LANGSMITH_WORKSPACE_ID=

# CONFIG | core | LaTeX compiler after sandbox and package tests
LATEX_ENGINE=

# CONFIG | core | Illustrative cost guard, not a provider spending limit
LLM_DAILY_BUDGET_USD=

# CONFIG | core | Bounded transient retries
LLM_MAX_RETRIES=

# CONFIG | core | Per-request deadline
LLM_REQUEST_TIMEOUT_SECONDS=

# CONFIG | core | Log verbosity; never log credentials or raw sensitive student content
LOG_LEVEL=

# CONFIG | core | Initial cap to avoid provider 429 and budget spikes
MAX_CONCURRENT_LLM_CALLS=

# CONFIG | core | Budget for document exporter
MAX_EXPORT_TIME_SECONDS=

# CONFIG | core | Illustrative 15 MiB maximum per upload; tune for requirements
MAX_UPLOAD_BYTES=

# SECRET | conditional | Only for optional hosted Mermaid API plan
MERMAID_API_KEY=

# CONFIG | core | Local Mermaid library/CLI by default
MERMAID_RENDER_MODE=

# PUBLIC | core | Browser-facing API path on same origin
NEXT_PUBLIC_API_BASE_PATH=

# PUBLIC | core | Public URL for the web app; okay to expose
NEXT_PUBLIC_APP_URL=

# PUBLIC | when-feature-enabled | Public feature visibility only
NEXT_PUBLIC_ENABLE_AI_IMAGES=

# PUBLIC | when-feature-enabled | Public feature visibility flag, NOT authorization
NEXT_PUBLIC_ENABLE_VOICE=

# PUBLIC | when-feature-enabled | Public DSN only if Sentry browser SDK is enabled; not a secret
NEXT_PUBLIC_SENTRY_DSN=

# PUBLIC | conditional | Cloudflare Turnstile public site key, if anti-bot protection enabled
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CONFIG | core | Bounded retries for delivery attempts
NOTIFICATION_RETRY_LIMIT=

# CONFIG | core | Used if SMS send/verify is delegated to notification service
NOTIFICATION_SERVICE_URL=

# CONFIG | conditional | Selected safe OCR method if fallback is enabled
OCR_ENGINE=

# CONFIG | core | Validate issuer, audience, state, nonce and PKCE
OIDC_ISSUER=

# SECRET | when-feature-enabled | OpenAI model API key
OPENAI_API_KEY=

# SECRET | conditional | Only if account/API plan requires it
OPENALEX_API_KEY=

# CONFIG | when-feature-enabled | OpenTelemetry collector endpoint; authentication configured separately
OTEL_EXPORTER_OTLP_ENDPOINT=

# CONFIG | when-feature-enabled | Service identity for distributed traces
OTEL_SERVICE_NAME=

# CONFIG | core | Verification attempt limit
OTP_MAX_ATTEMPTS=

# CONFIG | conditional | Choose one SMS provider before enabling mobile auth
OTP_PROVIDER=

# CONFIG | core | Illustrative rate limit, tune via abuse tests
OTP_RATE_LIMIT_PER_HOUR=

# CONFIG | core | OTP expiry
OTP_TTL_SECONDS=

# CONFIG | conditional | Choose stripe OR razorpay after business/payment evaluation
PAYMENT_PROVIDER=

# CONFIG | core | ReportLab or validated conversion pipeline
PDF_RENDERER=

# CONFIG | core | Versioned tested planner model name
PLANNER_MODEL_ID=

# CONFIG | core | Project quota collaboration endpoint
PROJECT_SERVICE_URL=

# CONFIG | core | Prompt version recorded with outputs
PROMPT_VERSION=

# CONFIG | conditional | Optional Pub/Sub fan-out topic; no Pub/Sub required for basic dispatch
PUBSUB_TOPIC_REPORT_EVENTS=

# CONFIG | when-feature-enabled | Evaluated LLM quality reviewer model ID
QUALITY_JUDGE_MODEL_ID=

# CONFIG | core | Upper bound for per-section targeted revisions
QUALITY_MAX_REVISIONS=

# CONFIG | core | Quality checks
QUALITY_SERVICE_URL=

# SECRET | core | R2 S3-compatible access key
R2_ACCESS_KEY_ID=

# CONFIG | core | Cloudflare account ID for constructing S3 endpoint
R2_ACCOUNT_ID=

# CONFIG | core | Private bucket; isolate production
R2_BUCKET_NAME=

# CONFIG | core | https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=

# SECRET | core | R2 S3-compatible secret access key
R2_SECRET_ACCESS_KEY=

# CONFIG | core | Short-lived private download/upload URL validity
R2_SIGNED_URL_TTL_SECONDS=

# CONFIG | conditional | If Razorpay selected; server-side config
RAZORPAY_KEY_ID=

# SECRET | conditional | Razorpay API secret
RAZORPAY_KEY_SECRET=

# SECRET | conditional | Webhook signature verification
RAZORPAY_WEBHOOK_SECRET=

# CONFIG | core | Session refresh lifetime, enforce rotation and revocation
REFRESH_TOKEN_TTL_DAYS=

# CONFIG | core | Cloud Run Job resource name
REPORT_GENERATION_JOB_NAME=

# CONFIG | core | Injected per execution by Cloud Run Job override; do not store permanently
REPORT_RUN_ID=

# CONFIG | conditional | Only when retrieval reranking is used
RERANK_MODEL_ID=

# SECRET | conditional | Only if Resend selected
RESEND_API_KEY=

# CONFIG | core | IAM-based service-to-service authentication, not an LLM/tool API key
S2S_AUTH_MODE=

# CONFIG | core | Bound outbound service HTTP calls
S2S_REQUEST_TIMEOUT_SECONDS=

# SECRET | conditional | Only if Semantic Scholar API with key used
SEMANTIC_SCHOLAR_API_KEY=

# SECRET | conditional | Only if SendGrid selected
SENDGRID_API_KEY=

# SECRET | conditional | Optional release/source-map upload token
SENTRY_AUTH_TOKEN=

# CONFIG | when-feature-enabled | Server-side tracing/error monitoring
SENTRY_DSN=

# CONFIG | core | Set separately to the service name
SERVICE_NAME=

# CONFIG | conditional | Choose SMS delivery/verification provider
SMS_PROVIDER=

# SECRET | conditional | Generic slot for another approved OTP provider
SMS_PROVIDER_API_KEY=

# CONFIG | core | Heartbeat interval for progress SSE stream
SSE_HEARTBEAT_SECONDS=

# CONFIG | conditional | Stripe price identifier if used
STRIPE_PREMIUM_PRICE_ID=

# CONFIG | conditional | Stripe price identifier if used
STRIPE_PRO_PRICE_ID=

# SECRET | conditional | If Stripe selected
STRIPE_SECRET_KEY=

# SECRET | conditional | Stripe signed webhook verification
STRIPE_WEBHOOK_SECRET=

# CONFIG | conditional | Tested transcription model ID
STT_MODEL_ID=

# CONFIG | conditional | Speech-to-text provider used after user permission
STT_PROVIDER=

# CONFIG | core | Canonical structured document model
TEMPLATE_RENDER_ENGINE=

# CONFIG | core | Template snapshot reference
TEMPLATE_SERVICE_URL=

# CONFIG | conditional | Tested speech generation model ID
TTS_MODEL_ID=

# CONFIG | conditional | Text-to-speech provider
TTS_PROVIDER=

# CONFIG | conditional | Selected speaking voice ID
TTS_VOICE_ID=

# SECRET | conditional | Server-side verification secret for Cloudflare Turnstile, if enabled
TURNSTILE_SECRET_KEY=

# CONFIG | conditional | Only if Twilio chosen for OTP
TWILIO_ACCOUNT_SID=

# SECRET | conditional | Only if Twilio chosen
TWILIO_AUTH_TOKEN=

# CONFIG | conditional | Only if Twilio Verify chosen
TWILIO_VERIFY_SERVICE_SID=

# CONFIG | core | Illustrative retention, finalize privacy policy
UPLOAD_RETENTION_DAYS=

# SECRET | when-feature-enabled | Upstash Redis REST token; never browser-visible
UPSTASH_REDIS_REST_TOKEN=

# CONFIG | when-feature-enabled | Upstash HTTPS REST endpoint
