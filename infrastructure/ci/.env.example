# Acadence Environment Variable Example | 2026-11-12
# Copy to .env locally (Cloudflare frontend: .dev.vars). Never commit real credentials.
# The names not explicitly named by the provider are ACADENCE-PROPOSED conventions.
# Core settings should be resolved for the phase using this module; conditional ones can stay blank.

# CORE | SECRET | CI deployment token for Workers/R2; least-privilege GitHub Actions secret
CLOUDFLARE_API_TOKEN=

# CORE | CONFIG | Cloudflare account for deployment tooling
CLOUDFLARE_ACCOUNT_ID=

# CORE | CONFIG | Google Cloud project
GCP_PROJECT_ID=

# CORE | CONFIG | Target Cloud Run region
GCP_REGION=

# CORE | CONFIG | Prefer WIF GitHub OIDC; avoid downloaded service-account key
GCP_WORKLOAD_IDENTITY_PROVIDER=

# CORE | CONFIG | CI deployment service account to impersonate via WIF
GCP_DEPLOY_SERVICE_ACCOUNT=

# CONDITIONAL | SECRET | Optional release/source-map upload token
SENTRY_AUTH_TOKEN=
